{
"compilerOptions": {
"rootDir": "./src",
"outDir": "./dist",

"module": "NodeNext",
"moduleResolution": "NodeNext",
"target": "ES2020",

"lib": ["ES2020"],
"types": ["node"],

"strict": true,
"esModuleInterop": true,
"resolveJsonModule": true,
"skipLibCheck": true,

"sourceMap": true,
"declaration": false,

"noUncheckedIndexedAccess": true,
"exactOptionalPropertyTypes": true

},
"include": ["src/**/*.ts"],
"exclude": ["node_modules", "dist"]
}
